# Copy to .env.local and fill in from Supabase: Project Settings -> API
# .env.local is gitignored — never commit real keys.

# Web app (safe for the browser; RLS makes these read-only)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Seed script + worker (server-side only; bypasses RLS)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional: higher-quality company logos for `npm run logos` (free at logo.dev)
LOGO_DEV_TOKEN=
